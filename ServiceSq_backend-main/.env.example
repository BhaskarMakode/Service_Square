NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/localconnect

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_DAYS=30

CLIENT_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
SMS_PROVIDER=console
SWAGGER_SERVER_URL=http://localhost:5000

REDIS_URL=

PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=INR
PAYMENT_WEBHOOK_SECRET=replace-with-payment-verification-secret
PLATFORM_COMMISSION_RATE=0.15

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_NAME=LocalConnect Admin
ADMIN_PHONE=+910000000000
ADMIN_EMAIL=admin@localconnect.test

DOCKER_API_PORT=5000
